GEMINI_API_KEY=your_api_key_here
# flash-lite is the fast tier (~3s). gemini-3.8-flash works but is far slower (~80s).
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: explore the UI without an API key. Results are clearly labelled MOCK.
# CHEATER_MOCK_MODE=1
# Optional mock scenario for demoing error handling: ok | rate_limit | timeout | malformed
# CHEATER_MOCK_SCENARIO=ok

# Optional: minimal | low | medium | high (Gemini 3.x). Lower = faster responses.
# flash-lite supports "minimal" (fastest). Note: gemini-3.8-flash does NOT — use "low" there.
GEMINI_THINKING_LEVEL=minimal
