GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional: explore the UI without an API key. Results are clearly labelled MOCK.
# CHEATER_MOCK_MODE=1
# Optional mock scenario for demoing error handling: ok | rate_limit | timeout | malformed
# CHEATER_MOCK_SCENARIO=ok

# Optional: minimal | low | medium | high (Gemini 3.x). Lower = faster responses.
# GEMINI_THINKING_LEVEL=low
